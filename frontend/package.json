{
  "name": "fidelity-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "React frontend for Fidelity's verdict.json — a real component app, separate from the single-file dashboard.html the Go CLI generates directly. Reads verdict.json at runtime (public/verdict.json in dev, or whatever is deployed alongside the built bundle).",
